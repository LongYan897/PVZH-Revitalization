[sub_resource type="Shader" id="Shader_de7fs"]
code = "shader_type canvas_item;

uniform vec4 color : source_color = vec4(1.0, 1.0, 1.0, 1.0);
uniform float strength : hint_range(0.0, 1.0) = 1.0;
uniform float keep_saturation : hint_range(0.0, 1.0) = 1.0;

vec3 rgb2hsl(vec3 c) {
	float maxc = max(max(c.r, c.g), c.b);
	float minc = min(min(c.r, c.g), c.b);
	float l = (maxc + minc) * 0.5;
	float h = 0.0;
	float s = 0.0;
	if (maxc != minc) {
		float d = maxc - minc;
		s = l > 0.5 ? d / (2.0 - maxc - minc) : d / (maxc + minc);
		if (maxc == c.r)      h = (c.g - c.b) / d + (c.g < c.b ? 6.0 : 0.0);
		else if (maxc == c.g) h = (c.b - c.r) / d + 2.0;
		else                  h = (c.r - c.g) / d + 4.0;
		h /= 6.0;
	}
	return vec3(h, s, l);
}

float hue2rgb(float p, float q, float t) {
	if (t < 0.0) t += 1.0;
	if (t > 1.0) t -= 1.0;
	if (t < 1.0/6.0) return p + (q - p) * 6.0 * t;
	if (t < 1.0/2.0) return q;
	if (t < 2.0/3.0) return p + (q - p) * (2.0/3.0 - t) * 6.0;
	return p;
}

vec3 hsl2rgb(vec3 hsl) {
	float h = hsl.x, s = hsl.y, l = hsl.z;
	if (s == 0.0) return vec3(l);
	float q = l < 0.5 ? l * (1.0 + s) : l + s - l * s;
	float p = 2.0 * l - q;
	return vec3(
		hue2rgb(p, q, h + 1.0/3.0),
		hue2rgb(p, q, h),
		hue2rgb(p, q, h - 1.0/3.0)
	);
}

void fragment() {
	vec4 tex = texture(TEXTURE, UV);
	vec3 hsl = rgb2hsl(tex.rgb);
	vec3 target = rgb2hsl(color.rgb);
	float newHue = mix(hsl.x, target.x, strength);
	float newSat = mix(target.y, hsl.y, keep_saturation);
	vec3 result = hsl2rgb(vec3(newHue, newSat, hsl.z));
	COLOR = vec4(result, tex.a * color.a);
}"

